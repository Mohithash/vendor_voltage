prebuilt_etc_xml {
    name: "sensitive_pn.xml",
    product_specific: true,
    src: "etc/sensitive_pn.xml",
    schema: ":spn-schema",
}

prebuilt_etc_xml {
    name: "bestrom-component-overrides.xml",
    product_specific: true,
    src: "etc/bestrom-component-overrides.xml",
    sub_dir: "sysconfig",
}

android_app_import {
    name: "Gramophone",
    apk: "Gramophone/Gramophone.apk",
    presigned: true,
    preprocessed: true,
    product_specific: true,
    optional_uses_libs: [
        "androidx.window.extensions",
        "androidx.window.sidecar",
    ],
}

android_app_import {
    name: "Jellyfish",
    apk: "Jellyfish/Jellyfish.apk",
    certificate: "platform",
    product_specific: true,
    optional_uses_libs: [
        "androidx.window.extensions",
        "androidx.window.sidecar",
    ],
}

android_app_import {
    name: "VoltageJump",
    apk: "VoltageJump/VoltageJump.apk",
    presigned: true,
    preprocessed: true,
    product_specific: true,
}
